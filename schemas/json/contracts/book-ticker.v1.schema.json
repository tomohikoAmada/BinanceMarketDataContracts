{
  "$defs": {
    "BookTickerMetadata": {
      "additionalProperties": false,
      "description": "Metadata specific to BookTicker events.",
      "properties": {
        "connection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Connection Id",
          "type": "string"
        },
        "exchange_event_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Event Time Ms"
        },
        "exchange_trade_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Trade Time Ms"
        },
        "exchange_transaction_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Transaction Time Ms"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "producer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "receive_monotonic_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Monotonic Ns"
        },
        "receive_time_utc_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Time Utc Ns"
        },
        "schema_version": {
          "const": "book-ticker.v1",
          "default": "book-ticker.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "const": "BOOK_TICKER",
          "default": "BOOK_TICKER",
          "title": "Stream",
          "type": "string"
        },
        "symbol": {
          "maxLength": 20,
          "minLength": 2,
          "pattern": "^[A-Z0-9]+$",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        }
      },
      "required": [
        "venue",
        "market",
        "symbol",
        "producer",
        "producer_version",
        "connection_id"
      ],
      "title": "BookTickerMetadata",
      "type": "object"
    },
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "QualityFlag": {
      "description": "Quality flags describe data facts — what is observed about the data.\n\nThese are distinct from ReasonCode which explains Health state judgments.",
      "enum": [
        "DUPLICATE",
        "OUT_OF_ORDER",
        "SEQUENCE_GAP",
        "ORDERBOOK_RESYNC",
        "SNAPSHOT_BRIDGE_PENDING",
        "SNAPSHOT_TOO_OLD",
        "BOOTSTRAP_BUFFER_OVERFLOW",
        "RECOVERED_TAIL",
        "MALFORMED_PAYLOAD",
        "EXCHANGE_TIME_MISSING",
        "RECEIVE_CLOCK_DISCONTINUITY",
        "SLOW_CONSUMER_GAP",
        "PRODUCER_RESTART",
        "OVERLAP",
        "IDENTITY_CONFLICT",
        "CROSSED_BOOK"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "BINANCE"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:book-ticker.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Binance book ticker — best bid and ask with quantities.\n\nUses BookTickerMetadata which fixes stream=BOOK_TICKER and schema_version.\nAccepts crossed books (best_bid_price >= best_ask_price).\nCrossed state is reported by Health through QualityFlag.CROSSED_BOOK.",
  "properties": {
    "best_ask_price": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "best_ask_quantity": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "best_bid_price": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "best_bid_quantity": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/BookTickerMetadata"
    },
    "update_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "metadata",
    "best_bid_price",
    "best_bid_quantity",
    "best_ask_price",
    "best_ask_quantity"
  ],
  "type": "object"
}
