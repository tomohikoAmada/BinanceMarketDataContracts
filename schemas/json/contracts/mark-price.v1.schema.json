{
  "$defs": {
    "MarkPriceMetadata": {
      "additionalProperties": false,
      "description": "Metadata for USD-M MarkPrice events.",
      "properties": {
        "connection_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Connection Id",
          "type": "string"
        },
        "exchange_event_time_ms": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Event Time Ms"
        },
        "exchange_trade_time_ms": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Trade Time Ms"
        },
        "exchange_transaction_time_ms": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Transaction Time Ms"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "producer": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Producer Version",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "receive_monotonic_ns": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Monotonic Ns"
        },
        "receive_time_utc_ns": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Time Utc Ns"
        },
        "schema_version": {
          "const": "mark-price.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "const": "MARK_PRICE",
          "title": "Stream",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u0020\\u007F])[\\s\\S]+$",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        }
      },
      "required": [
        "venue",
        "market",
        "symbol",
        "producer",
        "producer_version",
        "connection_id",
        "stream",
        "schema_version"
      ],
      "title": "MarkPriceMetadata",
      "type": "object"
    },
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "QualityFlag": {
      "description": "Quality flags describe data facts — what is observed about the data.\n\nThese are distinct from ReasonCode which explains Health state judgments.",
      "enum": [
        "DUPLICATE",
        "OUT_OF_ORDER",
        "SEQUENCE_GAP",
        "ORDERBOOK_RESYNC",
        "SNAPSHOT_BRIDGE_PENDING",
        "SNAPSHOT_TOO_OLD",
        "BOOTSTRAP_BUFFER_OVERFLOW",
        "RECOVERED_TAIL",
        "MALFORMED_PAYLOAD",
        "EXCHANGE_TIME_MISSING",
        "RECEIVE_CLOCK_DISCONTINUITY",
        "SLOW_CONSUMER_GAP",
        "PRODUCER_RESTART",
        "OVERLAP",
        "IDENTITY_CONFLICT",
        "CROSSED_BOOK"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "BINANCE"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:mark-price.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "USD-M mark-price update; T is next funding time, not transaction time.",
  "properties": {
    "estimated_settle_price": {
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
      "type": "string"
    },
    "funding_rate": {
      "pattern": "^(?:0(?:\\.[0-9]+)?|[1-9][0-9]*(?:\\.[0-9]+)?|-[1-9][0-9]*(?:\\.[0-9]+)?|-0\\.[0-9]*[1-9][0-9]*)$",
      "type": "string"
    },
    "index_price": {
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
      "type": "string"
    },
    "mark_price": {
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
      "type": "string"
    },
    "mark_price_moving_average": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "$ref": "#/$defs/MarkPriceMetadata"
    },
    "next_funding_time_ms": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "metadata",
    "mark_price",
    "index_price",
    "estimated_settle_price",
    "funding_rate",
    "next_funding_time_ms"
  ],
  "type": "object"
}
