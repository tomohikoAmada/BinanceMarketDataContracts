{
  "$defs": {
    "AggTradeMetadata": {
      "additionalProperties": false,
      "description": "Metadata for AggTrade events. stream and schema_version are required constants.",
      "properties": {
        "connection_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Connection Id",
          "type": "string"
        },
        "exchange_event_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Event Time Ms"
        },
        "exchange_trade_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Trade Time Ms"
        },
        "exchange_transaction_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Transaction Time Ms"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "producer": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Producer Version",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "receive_monotonic_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Monotonic Ns"
        },
        "receive_time_utc_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Time Utc Ns"
        },
        "schema_version": {
          "const": "agg-trade.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "const": "AGG_TRADE",
          "title": "Stream",
          "type": "string"
        },
        "symbol": {
          "maxLength": 20,
          "minLength": 2,
          "pattern": "^[A-Z0-9]+$",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        }
      },
      "required": [
        "venue",
        "market",
        "symbol",
        "producer",
        "producer_version",
        "connection_id",
        "stream",
        "schema_version"
      ],
      "title": "AggTradeMetadata",
      "type": "object"
    },
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "QualityFlag": {
      "description": "Quality flags describe data facts — what is observed about the data.\n\nThese are distinct from ReasonCode which explains Health state judgments.",
      "enum": [
        "DUPLICATE",
        "OUT_OF_ORDER",
        "SEQUENCE_GAP",
        "ORDERBOOK_RESYNC",
        "SNAPSHOT_BRIDGE_PENDING",
        "SNAPSHOT_TOO_OLD",
        "BOOTSTRAP_BUFFER_OVERFLOW",
        "RECOVERED_TAIL",
        "MALFORMED_PAYLOAD",
        "EXCHANGE_TIME_MISSING",
        "RECEIVE_CLOCK_DISCONTINUITY",
        "SLOW_CONSUMER_GAP",
        "PRODUCER_RESTART",
        "OVERLAP",
        "IDENTITY_CONFLICT",
        "CROSSED_BOOK"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "BINANCE"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:agg-trade.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Binance aggregated trade.\n\nUses AggTradeMetadata which fixes stream=AGG_TRADE and schema_version via Literal.\nquantity MUST be > 0.",
  "properties": {
    "aggregate_trade_id": {
      "minimum": 0,
      "type": "integer"
    },
    "buyer_is_maker": {
      "type": "boolean"
    },
    "first_trade_id": {
      "minimum": 0,
      "type": "integer"
    },
    "last_trade_id": {
      "minimum": 0,
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/AggTradeMetadata"
    },
    "price": {
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
      "type": "string"
    },
    "quantity": {
      "description": "Total quantity of the aggregate trade (> 0)",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
      "type": "string"
    },
    "trade_time_ms": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "metadata",
    "aggregate_trade_id",
    "price",
    "quantity",
    "first_trade_id",
    "last_trade_id",
    "trade_time_ms",
    "buyer_is_maker"
  ],
  "type": "object"
}
