{
  "$defs": {
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "PriceLevel": {
      "additionalProperties": false,
      "description": "A single price level in the order book.\n\nquantity represents the absolute quantity at this price level after the update.\nquantity == \"0\" means this price level should be removed.",
      "properties": {
        "price": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Price",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "price",
        "quantity"
      ],
      "title": "PriceLevel",
      "type": "object"
    },
    "Venue": {
      "enum": [
        "BINANCE"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:market-state-snapshot.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strategy-independent market state projection.",
  "properties": {
    "best_ask_price": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "best_ask_quantity": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "best_bid_price": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "best_bid_quantity": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "book_synchronized": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_freshness_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "depth_limit": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "funding_rate": {
      "anyOf": [
        {
          "pattern": "^(?:0(?:\\.[0-9]+)?|[1-9][0-9]*(?:\\.[0-9]+)?|-[1-9][0-9]*(?:\\.[0-9]+)?|-0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generated_time_utc_ns": {
      "minimum": 0,
      "type": "integer"
    },
    "index_price": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mark_price": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "market": {
      "$ref": "#/$defs/Market"
    },
    "microprice": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mid_price": {
      "anyOf": [
        {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "next_funding_time_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "open_interest": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "producer": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    },
    "schema_version": {
      "const": "market-state-snapshot.v1",
      "type": "string"
    },
    "source_book_update_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_trade_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "spread": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "symbol": {
      "maxLength": 20,
      "minLength": 2,
      "pattern": "^[A-Z0-9]+$",
      "type": "string"
    },
    "top_asks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PriceLevel"
      },
      "type": "array"
    },
    "top_bids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PriceLevel"
      },
      "type": "array"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
    }
  },
  "required": [
    "venue",
    "market",
    "symbol",
    "schema_version",
    "producer",
    "producer_version",
    "generated_time_utc_ns"
  ],
  "type": "object"
}
