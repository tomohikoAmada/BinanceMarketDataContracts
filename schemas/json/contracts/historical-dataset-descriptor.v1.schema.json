{
  "$defs": {
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "ReliabilityState": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_DUPLICATES",
        "DEGRADED",
        "GAP_PRESENT",
        "UNRELIABLE",
        "UNKNOWN"
      ],
      "title": "ReliabilityState",
      "type": "string"
    },
    "Stream": {
      "enum": [
        "DIFF_DEPTH",
        "AGG_TRADE",
        "BOOK_TICKER",
        "DEPTH_SNAPSHOT"
      ],
      "title": "Stream",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:historical-dataset-descriptor.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DRAFT — Describes a queryable, replayable historical dataset.",
  "properties": {
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "end_time_utc_ns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gap_count": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "gap_intervals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "manifest_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "market": {
      "$ref": "#/$defs/Market"
    },
    "partitions": {
      "default": 1,
      "minimum": 1,
      "type": "integer"
    },
    "producer": {
      "default": "recorder",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    },
    "query_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reliability_state": {
      "$ref": "#/$defs/ReliabilityState",
      "default": "UNKNOWN"
    },
    "replay_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "historical-dataset-descriptor.v1",
      "type": "string"
    },
    "source_manifests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "start_time_utc_ns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "streams": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Stream"
      },
      "type": "array"
    },
    "symbol": {
      "maxLength": 20,
      "minLength": 2,
      "pattern": "^[A-Z0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "market",
    "symbol",
    "schema_version",
    "producer_version"
  ],
  "type": "object"
}
