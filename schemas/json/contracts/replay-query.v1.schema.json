{
  "$defs": {
    "GapPolicy": {
      "enum": [
        "ERROR",
        "INCLUDE",
        "EXCLUDE"
      ],
      "title": "GapPolicy",
      "type": "string"
    },
    "MissingExchangeTimePolicy": {
      "enum": [
        "ERROR",
        "EXCLUDE",
        "FALLBACK_RECEIVE"
      ],
      "title": "MissingExchangeTimePolicy",
      "type": "string"
    },
    "ReplayClock": {
      "enum": [
        "RECEIVE_TIME",
        "EXCHANGE_TIME"
      ],
      "title": "ReplayClock",
      "type": "string"
    },
    "Stream": {
      "enum": [
        "DIFF_DEPTH",
        "AGG_TRADE",
        "BOOK_TICKER",
        "DEPTH_SNAPSHOT"
      ],
      "title": "Stream",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:replay-query.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DRAFT — Describes a historical replay request.",
  "properties": {
    "clock": {
      "$ref": "#/$defs/ReplayClock",
      "default": "RECEIVE_TIME"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "end_time_utc_ns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gap_policy": {
      "$ref": "#/$defs/GapPolicy",
      "default": "INCLUDE"
    },
    "missing_exchange_time_policy": {
      "$ref": "#/$defs/MissingExchangeTimePolicy",
      "default": "EXCLUDE"
    },
    "ordering_version": {
      "default": "1",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    },
    "schema_version": {
      "const": "replay-query.v1",
      "type": "string"
    },
    "start_time_utc_ns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "streams": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Stream"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "dataset_id"
  ],
  "type": "object"
}
