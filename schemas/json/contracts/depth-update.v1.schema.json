{
  "$defs": {
    "DepthUpdateMetadata": {
      "additionalProperties": false,
      "description": "Metadata for DepthUpdate events. stream and schema_version are required constants.",
      "properties": {
        "connection_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Connection Id",
          "type": "string"
        },
        "exchange_event_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Event Time Ms"
        },
        "exchange_trade_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Trade Time Ms"
        },
        "exchange_transaction_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Transaction Time Ms"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "producer": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Producer Version",
          "type": "string"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "receive_monotonic_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Monotonic Ns"
        },
        "receive_time_utc_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receive Time Utc Ns"
        },
        "schema_version": {
          "const": "depth-update.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "const": "DIFF_DEPTH",
          "title": "Stream",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u0020\\u007F])[\\s\\S]+$",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        }
      },
      "required": [
        "venue",
        "market",
        "symbol",
        "producer",
        "producer_version",
        "connection_id",
        "stream",
        "schema_version"
      ],
      "title": "DepthUpdateMetadata",
      "type": "object"
    },
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "PriceLevel": {
      "additionalProperties": false,
      "description": "A single price level in the order book.\n\nquantity represents the absolute quantity at this price level after the update.\nquantity == \"0\" means this price level should be removed.",
      "properties": {
        "price": {
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
          "title": "Price",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "price",
        "quantity"
      ],
      "title": "PriceLevel",
      "type": "object"
    },
    "QualityFlag": {
      "description": "Quality flags describe data facts — what is observed about the data.\n\nThese are distinct from ReasonCode which explains Health state judgments.",
      "enum": [
        "DUPLICATE",
        "OUT_OF_ORDER",
        "SEQUENCE_GAP",
        "ORDERBOOK_RESYNC",
        "SNAPSHOT_BRIDGE_PENDING",
        "SNAPSHOT_TOO_OLD",
        "BOOTSTRAP_BUFFER_OVERFLOW",
        "RECOVERED_TAIL",
        "MALFORMED_PAYLOAD",
        "EXCHANGE_TIME_MISSING",
        "RECEIVE_CLOCK_DISCONTINUITY",
        "SLOW_CONSUMER_GAP",
        "PRODUCER_RESTART",
        "OVERLAP",
        "IDENTITY_CONFLICT",
        "CROSSED_BOOK"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "BINANCE"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "$id": "urn:binance-market-data-contracts:depth-update.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Binance order book depth update.\n\nUses DepthUpdateMetadata which fixes stream=DIFF_DEPTH and schema_version via Literal.\nBoth are required in serialized form.",
  "properties": {
    "asks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PriceLevel"
      },
      "type": "array"
    },
    "bids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PriceLevel"
      },
      "type": "array"
    },
    "final_update_id": {
      "minimum": 0,
      "type": "integer"
    },
    "first_update_id": {
      "minimum": 0,
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/DepthUpdateMetadata"
    },
    "previous_final_update_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "metadata",
    "first_update_id",
    "final_update_id"
  ],
  "type": "object"
}
