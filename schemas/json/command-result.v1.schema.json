{
  "$defs": {
    "CommandStatus": {
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "COMPLETED",
        "FAILED",
        "REJECTED",
        "TIMED_OUT"
      ],
      "title": "CommandStatus",
      "type": "string"
    }
  },
  "$id": "binance-market-data/command-result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DRAFT — Result of a control command execution.",
  "properties": {
    "audit_metadata": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Audit trail metadata (keys and values are strings for schema stability)"
    },
    "command_id": {
      "description": "Command identifier matching the request",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Machine-readable error code on failure"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable error description on failure"
    },
    "executed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ISO-8601 UTC timestamp when the command completed"
    },
    "requested_at": {
      "type": "string"
    },
    "result_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Summary of the command result"
    },
    "schema_version": {
      "default": "command-result.v1",
      "description": "Contract schema version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CommandStatus"
    }
  },
  "required": [
    "command_id",
    "status",
    "requested_at"
  ],
  "type": "object"
}
