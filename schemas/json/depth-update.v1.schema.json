{
  "$defs": {
    "EventMetadata": {
      "additionalProperties": false,
      "description": "Metadata envelope for all market events.\n\nAll times use the unit-embedded naming convention.\nMissing exchange times use None, never 0.",
      "properties": {
        "connection_id": {
          "description": "Unique identifier for this connection session",
          "title": "Connection Id"
        },
        "exchange_event_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exchange-assigned event time in milliseconds",
          "title": "Exchange Event Time Ms"
        },
        "exchange_trade_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exchange-assigned trade time in milliseconds",
          "title": "Exchange Trade Time Ms"
        },
        "exchange_transaction_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exchange-assigned transaction time in milliseconds",
          "title": "Exchange Transaction Time Ms"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "producer": {
          "description": "Producer module name (e.g. 'recorder', 'gateway')",
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "description": "Producer module version",
          "title": "Producer Version",
          "type": "string"
        },
        "quality_flags": {
          "description": "Quality flags describing observed data facts",
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "receive_monotonic_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monotonic clock receive time in nanoseconds",
          "title": "Receive Monotonic Ns"
        },
        "receive_time_utc_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC wall clock receive time in nanoseconds",
          "title": "Receive Time Utc Ns"
        },
        "schema_version": {
          "description": "Contract version (e.g. 'depth-update.v1')",
          "title": "Schema Version",
          "type": "string"
        },
        "stream": {
          "$ref": "#/$defs/Stream"
        },
        "symbol": {
          "title": "Symbol"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        }
      },
      "required": [
        "venue",
        "market",
        "symbol",
        "stream",
        "producer",
        "producer_version",
        "schema_version",
        "connection_id"
      ],
      "title": "EventMetadata",
      "type": "object"
    },
    "Market": {
      "enum": [
        "SPOT",
        "USD_M_PERPETUAL"
      ],
      "title": "Market",
      "type": "string"
    },
    "PriceLevel": {
      "additionalProperties": false,
      "description": "A single price level in the order book.\n\nquantity represents the absolute quantity at this price level after the update.\nquantity == \"0\" means this price level should be removed.",
      "properties": {
        "price": {
          "title": "Price"
        },
        "quantity": {
          "title": "Quantity"
        }
      },
      "required": [
        "price",
        "quantity"
      ],
      "title": "PriceLevel",
      "type": "object"
    },
    "QualityFlag": {
      "description": "Quality flags describe data facts — what is observed about the data.\n\nThese are distinct from ReasonCode which explains Health state judgments.",
      "enum": [
        "DUPLICATE",
        "OUT_OF_ORDER",
        "SEQUENCE_GAP",
        "ORDERBOOK_RESYNC",
        "SNAPSHOT_BRIDGE_PENDING",
        "SNAPSHOT_TOO_OLD",
        "BOOTSTRAP_BUFFER_OVERFLOW",
        "RECOVERED_TAIL",
        "MALFORMED_PAYLOAD",
        "EXCHANGE_TIME_MISSING",
        "RECEIVE_CLOCK_DISCONTINUITY",
        "SLOW_CONSUMER_GAP",
        "PRODUCER_RESTART",
        "OVERLAP",
        "IDENTITY_CONFLICT",
        "CROSSED_BOOK"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "Stream": {
      "enum": [
        "DIFF_DEPTH",
        "AGG_TRADE",
        "BOOK_TICKER",
        "DEPTH_SNAPSHOT"
      ],
      "title": "Stream",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "BINANCE"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "$id": "binance-market-data/depth-update.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Binance order book depth update.\n\nRepresents a diff depth event with bids and asks at updated price levels.\nThe metadata.stream MUST be DIFF_DEPTH.",
  "properties": {
    "asks": {
      "description": "Updated ask price levels",
      "items": {
        "$ref": "#/$defs/PriceLevel"
      },
      "type": "array"
    },
    "bids": {
      "description": "Updated bid price levels",
      "items": {
        "$ref": "#/$defs/PriceLevel"
      },
      "type": "array"
    },
    "final_update_id": {
      "description": "Final update ID in this event",
      "minimum": 0,
      "type": "integer"
    },
    "first_update_id": {
      "description": "First update ID in this event",
      "minimum": 0,
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/EventMetadata"
    },
    "previous_final_update_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Previous final update ID (available in USD-M Diff Depth as 'pu')"
    }
  },
  "required": [
    "metadata",
    "first_update_id",
    "final_update_id"
  ],
  "type": "object"
}
