{
  "$defs": {
    "Stream": {
      "enum": [
        "DIFF_DEPTH",
        "AGG_TRADE",
        "BOOK_TICKER",
        "DEPTH_SNAPSHOT"
      ],
      "title": "Stream",
      "type": "string"
    }
  },
  "$id": "binance-market-data/replay-query.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DRAFT — Describes a historical replay request.\n\nOrdering rules are versioned via ordering_version.",
  "properties": {
    "clock": {
      "default": "receive_time",
      "description": "Clock used for ordering (e.g. 'receive_time', 'exchange_time')",
      "type": "string"
    },
    "dataset_id": {
      "description": "Dataset identifier to replay",
      "type": "string"
    },
    "end": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay end position (ISO-8601 or seek key)"
    },
    "gap_policy": {
      "default": "report",
      "description": "Policy for gaps: 'report', 'skip_gap', 'abort'",
      "type": "string"
    },
    "missing_exchange_time_policy": {
      "default": "skip",
      "description": "Policy for events with missing exchange time: 'skip', 'error', 'use_receive_time'",
      "type": "string"
    },
    "ordering_version": {
      "default": "1",
      "description": "Version of the ordering rules to apply",
      "type": "string"
    },
    "start": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay start position (ISO-8601 or seek key)"
    },
    "streams": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Stream"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Streams to replay (None = all available)"
    }
  },
  "required": [
    "dataset_id"
  ],
  "type": "object"
}
